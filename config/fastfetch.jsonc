{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 2,
      "left": 1,
      "right": 2,
    },
  },
  "display": {
    "separator": " ➜  ",
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "blue",
        "at": "red",
        "host": "blue",
      },
    },
    "separator",
    {
      "type": "os",
      "key": "󰍲 OS",
      "keyColor": "cyan",
    },
    {
      "type": "kernel",
      "key": " Kernel",
      "keyColor": "cyan",
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "cyan",
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "cyan",
    },
    {
      "type": "shell",
      "key": " Shell",
      "keyColor": "cyan",
    },
    {
      "type": "display",
      "key": "󰍹 Display",
      "keyColor": "blue",
    },
    {
      "type": "cpu",
      "key": " CPU",
      "keyColor": "blue",
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "keyColor": "blue",
    },
    {
      "type": "memory",
      "key": " RAM",
      "keyColor": "blue",
    },
    {
      "type": "disk",
      "key": "󰋊 Disk",
      "keyColor": "blue",
    },
    {
      "type": "battery",
      "key": "󰁹 Battery",
      "keyColor": "green",
    },
    {
      "type": "localip",
      "key": "󰩟 Local IP",
      "keyColor": "green",
      "showIpv6": false,
    },
    "break",
    "colors",
  ],
}
